{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file", // 任务标签，会被 launch.json 引用
            "command": "/usr/bin/g++", // 编译器路径
            "args": [
                "-g",          // 生成调试信息，调试必须
                "${file}",     // 当前要编译的文件
                "-o",          // 指定输出
                "${fileDirname}/${fileBasenameNoExtension}" // 可执行文件路径
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}